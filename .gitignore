# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Competition data — redownload with:
#   uv run kaggle competitions download -c playground-series-s6e9 -p data
data/

# Submission CSVs and OOF arrays — regenerated by the scripts
submissions/

# Original dataset the episode was generated from — redownload with:
#   uv run kaggle datasets download itzzomkar/ev-adoption-behavior-and-range-anxiety -p data/orig --unzip

# Transient per-run console captures — everything is appended to runs.log
*.out

# --- Cleanup coverage (see CLEANUP.md) ---
# Secrets: never commit (kept by the CLEANUP.md commands on purpose)
.env
.env.*
*.key
kaggle.json
access_token

# Virtualenv variants and tool caches
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Untracked numeric outputs / competition data written outside data/ or submissions/
/*.npy
/*.parquet
/*.csv
/*.pkl

# OS / editor
.DS_Store
.idea/
.vscode/
